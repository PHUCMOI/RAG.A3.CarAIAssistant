DATABASE_URL=postgresql://car_rag:car_rag_dev@localhost:5432/car_rag
FRONTEND_ORIGIN=http://localhost:5173
PORT=5080
ENVIRONMENT=development
RAG_ENABLED=true
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Tested snapshot; query and document embeddings must use the same revision.
EMBEDDING_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
EMBEDDING_CACHE_DIR=.venv/models/text
# All AI generation uses Amazon Bedrock.
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_TIMEOUT=30
# Set real credentials only in your ignored .env or process environment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Native Python also supports AWS_PROFILE and the standard AWS credential chain.

# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_INTERNAL_TOKEN=
